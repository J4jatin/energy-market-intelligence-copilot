# Groq (free, OpenAI-compatible) — powers RAG answers + AI summaries
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Microsoft SharePoint (Azure App Registration)
SHAREPOINT_SITE_URL=https://yourtenant.sharepoint.com/sites/MarketIntelligence
SHAREPOINT_CLIENT_ID=your_azure_app_client_id
SHAREPOINT_CLIENT_SECRET=your_azure_app_client_secret
SHAREPOINT_TENANT_ID=your_azure_tenant_id

# Email (optional, for newsletter delivery)
EMAIL_SMTP_HOST=smtp.office365.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=your_email@company.com
EMAIL_SMTP_PASS=your_email_password
EMAIL_RECIPIENTS=team@company.com,manager@company.com
